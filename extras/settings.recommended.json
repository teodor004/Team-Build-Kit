{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": { "baseRef": "head" },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:owasp.org)", "WebFetch(domain:*.owasp.org)",
      "WebFetch(domain:cheatsheetseries.owasp.org)",
      "WebFetch(domain:w3.org)", "WebFetch(domain:www.w3.org)", "WebFetch(domain:*.w3.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:www.rfc-editor.org)", "WebFetch(domain:datatracker.ietf.org)",
      "WebFetch(domain:spec.openapis.org)", "WebFetch(domain:json-schema.org)",
      "WebFetch(domain:nodejs.org)", "WebFetch(domain:react.dev)", "WebFetch(domain:vite.dev)",
      "WebFetch(domain:expressjs.com)", "WebFetch(domain:www.typescriptlang.org)",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git rev-parse *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git merge *)", "Bash(git merge-base *)",
      "Bash(git worktree *)", "Bash(git branch *)", "Bash(git checkout *)",
      "Bash(npm test *)", "Bash(npm run *)", "Bash(npm ci *)", "Bash(npm install *)", "Bash(npx *)",
      "Bash(sha256sum *)", "Bash(date *)"
    ],
    "deny": [
      "Bash(git push *)", "Bash(sudo *)",
      "Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)",
      "Agent(model:fable)", "Agent(model:best)", "Agent(model:inherit)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "4",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  }
}
